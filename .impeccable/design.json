      "html": "<div class=\"ds-sample\"><nav class=\"ds-range\" aria-label=\"Intervalul din simulare\"><a href=\"?hours=1\">1 oră</a><a href=\"?hours=6\" aria-current=\"true\">6 ore</a><a href=\"?hours=24\">24 ore</a></nav></div>",
      "css": ".ds-sample{font:14px/1.6 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--ink,#1d1d1f)}.ds-sample :focus-visible{outline:3px solid var(--blue,#0066cc);outline-offset:3px}.ds-range{display:inline-flex;gap:2px;padding:4px;background:#e9ebef;border-radius:var(--control-radius,10px)}.ds-range a{display:grid;place-items:center;min-height:36px;padding:6px 18px;border-radius:7px;color:var(--muted,#626873);font-size:13px;font-weight:550;font-variant-numeric:tabular-nums;text-decoration:none}.ds-range a:hover{color:var(--ink,#1d1d1f)}.ds-range a[aria-current]{background:var(--surface,#ffffff);color:var(--ink,#1d1d1f);box-shadow:0 1px 3px #1d1d1f14}@media(max-width:620px){.ds-range a{padding:6px 15px}}"
